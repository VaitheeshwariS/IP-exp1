<!DOCTYPE html>
<html>
<head>

    <meta charset="UTF-8">

    <title>Blood Donor Management System</title>

    <link rel="stylesheet" href="css/style.css">

</head>

<body>

<header class="navbar">

    <div class="logo">
         Blood Donor
    </div>

    <nav>
        <a href="index.jsp">Home</a>
        <a href="register.jsp">Register</a>
        <a href="search.jsp">Find Blood</a>
        <a href="login.jsp">Login</a>
    </nav>

</header>

<section class="hero">

    <div class="hero-content">

        <h1>Save Lives, Donate Blood</h1>

        <p>
            Blood Donor Management System helps connect
            blood donors with people who need blood.
        </p>

        <div class="hero-buttons">

            <a href="register.jsp" class="btn">
                Become a Donor
            </a>

            <a href="search.jsp" class="btn secondary">
                Find Blood
            </a>

        </div>

    </div>

</section>

<section class="features">

    <h2>Our Services</h2>

    <div class="card-container">

        <div class="card">

            <div class="icon">?</div>

            <h3>Donate Blood</h3>

            <p>
                Register yourself as a blood donor
                and help save lives.
            </p>

        </div>

        <div class="card">

            <div class="icon">?</div>

            <h3>Find Blood</h3>

            <p>
                Search for available donors
                based on blood group.
            </p>

        </div>

        <div class="card">

            <div class="icon">?</div>

            <h3>Donor Management</h3>

            <p>
                Manage donor information
                through a centralized system.
            </p>

        </div>

    </div>

</section>

<footer>

    <p>
        © 2026 Blood Donor Management System
    </p>

</footer>

<script src="js/script.js"></script>

</body>
</html>